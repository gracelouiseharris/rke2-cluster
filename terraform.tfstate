      "mode": "managed",
      "type": "libvirt_cloudinit_disk",
      "name": "init",
      "provider": "provider[\"registry.terraform.io/dmacvicar/libvirt\"]",
      "instances": [
        {
          "index_key": "rke2-agent-1",
          "schema_version": 0,
          "attributes": {
            "id": "/var/lib/libvirt/images/rke2-agent-1-cloudinit.iso;572fd52c-7ebf-4054-9ff8-1e7e6ac0fa8d",
            "meta_data": "",
            "name": "rke2-agent-1-cloudinit.iso",
            "network_config": "",
            "pool": "default",
            "user_data": "#cloud-config\nhostname: rke2-agent-1\nfqdn: rke2-agent-1\nmanage_etc_hosts: true\n\nusers:\n  - name: ubuntu\n    groups: sudo\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - ssh-rsa  grace.harris@rke2-lab\n\nssh_pwauth: false\ndisable_root: true\n\npackage_update: true\npackage_upgrade: false\npackages:\n  - qemu-guest-agent\n  - curl\n  - tar\n  - iptables\n\n# growpart/resizefs run automatically as default cloud-init modules on\n# Ubuntu's cloud image, so the root filesystem expands to fill the disk\n# without any extra runcmd steps.\n\nruncmd:\n  - systemctl enable --now qemu-guest-agent\n  - swapoff -a\n  - modprobe br_netfilter\n  - modprobe overlay\n  - echo \"net.bridge.bridge-nf-call-iptables = 1\" \u003e\u003e /etc/sysctl.d/99-kubernetes.conf\n  - echo \"net.ipv4.ip_forward = 1\" \u003e\u003e /etc/sysctl.d/99-kubernetes.conf\n  - sysctl --system\n"
          },
          "sensitive_attributes": [],
          "private": "bnVsbA=="
        },
        {
          "index_key": "rke2-agent-2",
          "schema_version": 0,
